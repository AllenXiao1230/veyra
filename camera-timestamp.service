[Unit]
Description=Camera Timestamp Burn-in MJPEG Stream
After=network.target

[Service]
Type=simple
User=xuan
Group=xuan
ExecStart=/usr/bin/python3 /srv/camera-monitor/app/timestamp/server.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/camera-monitor/data/timestamp
RestrictAddressFamilies=AF_INET AF_UNIX
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
