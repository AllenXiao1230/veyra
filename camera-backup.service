[Unit]
Description=Verified incremental Camera Monitor backup
After=network-online.target camera-ai.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/camera-maintenance backup
TimeoutStartSec=3600
Nice=10
IOSchedulingClass=idle
UMask=0077
StateDirectory=camera-maintenance
NoNewPrivileges=true
PrivateTmp=true
