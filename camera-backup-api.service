[Unit]
Description=Camera Monitor local backup manager
After=network.target camera-ai.service camera-recorder-api.service

[Service]
Type=simple
User=root
WorkingDirectory=/srv/camera-monitor/app/management
ExecStart=/usr/bin/python3 /srv/camera-monitor/app/management/backup_api.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=3600
LimitNOFILE=16384
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/camera-monitor/data/maintenance /srv/camera-monitor/backups
RestrictAddressFamilies=AF_INET AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
