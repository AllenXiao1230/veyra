server {
    listen 127.0.0.1:8090;
    server_name _;

    # Slow mobile downloads may pause; timeout is between writes, not total duration.
    send_timeout 300s;

    location = /snapshots.html {
        add_header Cache-Control "no-store, max-age=0" always;
        root /srv/camera-monitor/web;
        try_files /snapshots.html =404;
    }

    location = /backups.html {
        add_header Cache-Control "no-store, max-age=0" always;
        root /srv/camera-monitor/web;
        try_files /backups.html =404;
    }

    location /backups-api/ {
        proxy_pass http://127.0.0.1:8095/;
        proxy_set_header Host $http_host;
        proxy_read_timeout 60s;
        client_max_body_size 8k;
    }

    location /events-api/ {
        proxy_pass http://127.0.0.1:8095/events/;
        proxy_set_header Host $http_host;
        proxy_read_timeout 60s;
        proxy_buffering off;
        client_max_body_size 16k;
    }

    location ~ ^/camera-(ui\.css|ui\.js|live\.js|library\.js|backups\.js|mobile\.js|timeline\.js)$ {
        add_header Cache-Control "no-cache" always;
        root /srv/camera-monitor/web;
        try_files $uri =404;
    }

    location = /recordings.html {
        add_header Cache-Control "no-store, max-age=0" always;
        root /srv/camera-monitor/web;
        try_files /recordings.html =404;
    }

    location = / {
        add_header Cache-Control "no-store, max-age=0" always;
        root /srv/camera-monitor/web;
        try_files /index.html =404;
    }

    location = /index.html {
        add_header Cache-Control "no-store, max-age=0" always;
        root /srv/camera-monitor/web;
        try_files /index.html =404;
    }

    
    # Camera Recorder API: backend listens on localhost only
    location ^~ /recordings-api/file/ {
        proxy_pass http://127.0.0.1:8091/file/;
        proxy_set_header Host $http_host;
        proxy_http_version 1.1;
        # Decouple short client stalls without spooling entire videos to disk.
        proxy_buffering on;
        proxy_buffers 8 64k;
        proxy_busy_buffers_size 128k;
        proxy_max_temp_file_size 0;
        proxy_read_timeout 300s;
        gzip off;
    }

    location /recordings-api/ {
        proxy_pass http://127.0.0.1:8091/;
        proxy_set_header Host $http_host;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        client_max_body_size 1m;
    }

location /camera/ {
        proxy_pass http://127.0.0.1:8093/;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    location = /mic {
        proxy_pass http://127.0.0.1:8889/mic;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /audio-api/level {
        proxy_pass http://127.0.0.1:8094/level;
        proxy_set_header Host $http_host;
        proxy_read_timeout 5s;
        access_log off;
    }

    location /audio-api/ {
        proxy_pass http://127.0.0.1:8094/;
        proxy_set_header Host $http_host;
        proxy_http_version 1.1;
        proxy_read_timeout 10s;
        client_max_body_size 8k;
    }

    location = /camera-audio-controls.js {
        add_header Cache-Control "no-cache" always;
        root /srv/camera-monitor/web;
        try_files $uri =404;
    }

    location /mic/ {
        proxy_pass http://127.0.0.1:8889;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_buffering off;
    }

    # BEGIN browser-motion-detection
    location = /motion.html {
        return 302 /snapshots.html;
    }

    location = /motion-detection.js {
        return 410;
    }
    # END browser-motion-detection

    # BEGIN camera-ai
    # Loopback-only AI event API; the existing recorder and streams remain unchanged.
    location /ai-api/ {
        proxy_pass http://127.0.0.1:8092/;
        proxy_set_header Host $http_host;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        client_max_body_size 1m;
    }
    location = /camera-ai-events.js {
        add_header Cache-Control "no-cache" always;
        root /srv/camera-monitor/web;
        try_files $uri =404;
    }
    location = /camera-ai-events.css {
        root /srv/camera-monitor/web;
        try_files $uri =404;
    }
    # END camera-ai
}
